{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://adawise-momo-backend.onrender.com/api/$1" },
    { "source": "/((?!api/|assets/|icons/|brand/|illustrations/|adawise/highlights/|sw.js|workbox-|manifest.webmanifest|registerSW.js).*)", "destination": "/index.html" }
  ]
}
